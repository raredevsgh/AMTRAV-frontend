{
  "name": "amtrav",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev:landing": "pnpm --filter landing_page dev",
    "dev:admin": "pnpm --filter admin_panel dev",
    "dev:admin:demo": "AMTRAV_CONSOLE_DEMO=1 pnpm --filter admin_panel dev --port 3151",
    "build:landing": "pnpm --filter landing_page build",
    "build:admin": "pnpm --filter admin_panel build",
    "lint:landing": "pnpm --filter landing_page lint",
    "lint:admin": "pnpm --filter admin_panel lint",
    "sprint": "node --experimental-strip-types scripts/sprint-automation/src/main.ts",
    "sprint:test": "node --test --experimental-strip-types scripts/sprint-automation/tests/*.test.ts",
    "autoclose": "node --experimental-strip-types scripts/autoclose-tasks.ts",
    "test:admin": "node --import ./scripts/register-typescript.mjs --test admin_panel/lib/api/*.test.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.20.0"
}
