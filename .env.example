# Server-only URL. The browser talks to the same-origin console gateway.
BACKEND_API_URL=http://127.0.0.1:8090/api/v1

# Mapbox PUBLIC token (pk.*), restricted to your frontend URLs in Mapbox.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Direct WebSocket URL through the API reverse proxy. Use wss:// with HTTPS.
NEXT_PUBLIC_LOCATION_WS_URL=ws://localhost:8090/api/v1/admin/locations/stream

# Optional public website destinations. Leave empty until available.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_CONTACT_URL=

# The website's public address, for canonical links, hreflang, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://amortrav.com
