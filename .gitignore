# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local visual review captures
/artifacts/

# Commit configuration guidance, never real credentials.
!.env.example

# Copied from @sqlite.org/sqlite-wasm by scripts/copy-sqlite.mjs
/public/sqlite/

# cloudflare (OpenNext build output and wrangler state)
/.open-next/
/.wrangler/
.dev.vars*
