#!/bin/sh
# Blocks commits that contain secret files or secrets in staged changes.
# Enable once per clone: git config core.hooksPath .githooks
set -eu

# 1. Secret files by name. Needs no extra tools. .env.example templates are allowed.
blocked=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '(^|/)(\.env(\..+)?|[^/]+\.(pem|key|p12|pfx|jks|keystore)|id_(rsa|dsa|ecdsa|ed25519)[^/]*)$' \
  | grep -vE '(^|/)\.env\.example$' || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit secret files:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  echo "Unstage them with 'git restore --staged <file>'; they must never be committed." >&2
  exit 1
fi

# 2. Secrets inside staged content (API keys, tokens, private keys, passwords).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged changes cannot be scanned for secrets." >&2
  echo "Install it (Windows: winget install Gitleaks.Gitleaks | macOS: brew install gitleaks) and commit again." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --verbose
