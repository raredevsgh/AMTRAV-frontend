// The website on Cloudflare Workers. `pnpm run build` builds it with OpenNext; `pnpm run deploy`
// (or Workers Builds: build, then `wrangler deploy`) deploys it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amortrav",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // Server-side only: where the console, shop and lead routes reach the API.
    "BACKEND_API_URL": "https://dev.amortrav.com/api/v1"
  },
  // Keep variables and secrets set in the dashboard (the Mapbox token is a build variable there).
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the worker call itself; the name must match the worker's.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "amortrav"
    }
  ],
  "images": {
    // next/image resizing through Cloudflare Images.
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
